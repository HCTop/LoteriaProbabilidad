<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- "no_backup" ya queda fuera de backup/transferencia por defecto; no es
         un domain válido aquí y antes rompía el build con lint estricto. -->
    <cloud-backup>
        <include domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
